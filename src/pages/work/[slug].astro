---
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectProse from '../../components/project/ProjectProse.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
	}));
}

const { slug } = Astro.params;
const project = await getEntry('projects', slug!);

if (!project) {
	return Astro.redirect('/work/');
}

const writing = await getCollection('writing');
const writingSlugs = new Set(writing.map((entry) => entry.id));
const hasNotes = project.data.notes
	? writingSlugs.has(project.data.notes)
	: false;
---

<PageLayout title={`${project.data.title} — Jonas`} narrow>
	<ProjectProse project={project} hasNotes={hasNotes} />
</PageLayout>

---
import HomeLayout from '../layouts/HomeLayout.astro';
import GitHubHeatmap from '../components/home/GitHubHeatmap.astro';
import HomeGifRunner from '../components/home/HomeGifRunner.astro';
import HomeClip from '../components/home/HomeClip.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<HomeLayout title="Jonas">
	<SiteHeader />
	<main class="main">
		<div class="main-top">
			<p class="eyebrow">Software · backend · full-stack</p>
			<h1 class="greeting">Hey — I'm Jonas.</h1>
			<div class="intro">
				<p>
					I build web products end to end — APIs, databases, and interfaces. Open
					to full-time roles and freelance.
					<a href="/about/" class="link-accent">More about me →</a>
				</p>
				<p class="status-pill">Available for new projects</p>
			</div>
			<div class="actions">
				<p>
					<a
						href="/Yonas_Girma_Resume.pdf"
						class="link-accent"
						target="_blank"
						rel="noopener noreferrer">Download my resume</a
					>
				</p>
			</div>
		</div>
		<GitHubHeatmap />
		<div class="home-media-stack">
			<!-- <HomeGifRunner /> -->
			<HomeClip />
		</div>
	</main>
	<HomeFooter />
</HomeLayout>

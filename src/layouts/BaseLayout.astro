---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Jonas', description = 'Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<ClientRouter />
		<script is:inline>
			(function () {
				function applyTheme() {
					try {
						var stored = localStorage.getItem('theme');
						var light =
							stored === 'light' ||
							(stored !== 'dark' &&
								window.matchMedia('(prefers-color-scheme: light)').matches);
						if (light) {
							document.documentElement.classList.add('theme-light');
						} else {
							document.documentElement.classList.remove('theme-light');
						}
					} catch (_) {}
				}
				applyTheme();
				document.addEventListener('astro:after-swap', applyTheme);
			})();
		</script>
		<script is:inline>
			function initReveal() {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				var elements = Array.from(document.querySelectorAll('[data-reveal]'));
				if (!elements.length) return;

				var observer = new IntersectionObserver(
					function (entries) {
						var visible = entries.filter(function (e) { return e.isIntersecting; });
						visible.forEach(function (entry, idx) {
							var el = entry.target;
							if (!el.style.getPropertyValue('--reveal-delay')) {
								el.style.setProperty('--reveal-delay', (idx * 40) + 'ms');
							}
							el.classList.add('data-inview');
							observer.unobserve(el);
						});
					},
					{ rootMargin: '0px 0px -5% 0px', threshold: 0.01 }
				);

				elements.forEach(function (el) {
					if (!el.classList.contains('data-inview')) {
						observer.observe(el);
					}
				});
			}

			if (document.readyState !== 'loading') initReveal();
			else document.addEventListener('DOMContentLoaded', initReveal);
			document.addEventListener('astro:page-load', initReveal);
		</script>
		<style is:inline>
			.page {
				max-width: 42rem;
				margin: 0 auto;
				padding: 3rem 1.25rem clamp(0.75rem, 1.5vh, 1rem);
			}
			@media (min-width: 768px) {
				.page {
					padding: 4rem 0 clamp(0.75rem, 1.5vh, 1rem);
				}
			}
			.page .site-head,
			.page .site-header {
				margin-bottom: 0;
			}
		</style>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caesar+Dressing&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

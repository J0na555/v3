---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	hasNotes?: boolean;
}

const { project, hasNotes = false } = Astro.props;
const { title, role, dek, stack, liveDemo, github, figure, notes } =
	project.data;
const { Content } = await render(project);

const showNotes = Boolean(notes && hasNotes);
const showExternalLinks = Boolean(liveDemo || github);
const showLinks = showExternalLinks || showNotes;
---

<div class="project-prose">
	<a href="/work/" class="back">← All work</a>
	{role && <p class="meta-row">{role}</p>}
	<h1>{title}</h1>
	{dek && <p class="dek">{dek}</p>}
	<figure class="figure" role="img" aria-label="Project preview">
		{figure ?? 'Preview'}
	</figure>
	<article class="prose">
		<Content />
		{
			stack && stack.length > 0 && (
				<section>
					<h2>Stack</h2>
					<div class="stack-tags">
						{stack.map((item) => (
							<span>{item}</span>
						))}
					</div>
				</section>
			)
		}
	</article>
	{
		showLinks && (
			<nav class="project-links">
				<span class="label">Links</span>
				{
					liveDemo && (
						<a href={liveDemo} target="_blank" rel="noopener noreferrer">
							Live demo
						</a>
					)
				}
				{liveDemo && github && <span class="sep">·</span>}
				{
					github && (
						<a href={github} target="_blank" rel="noopener noreferrer">
							GitHub
						</a>
					)
				}
				{
					showNotes && (
						<>
							{showExternalLinks && <span class="sep">·</span>}
							<a href={`/writing/${notes}/`} class="is-accent">
								Notes
							</a>
						</>
					)
				}
			</nav>
		)
	}
</div>

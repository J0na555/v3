<button type="button" class="theme-btn" aria-label="Switch to light mode">
	<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path
			d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
		></path>
	</svg>
	<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
	</svg>
</button>

<script>
	import { THEME_STORAGE_KEY, applyDocumentTheme } from '../lib/theme';

	function syncToggleLabels(light: boolean) {
		const label = light ? 'Switch to dark mode' : 'Switch to light mode';
		document.querySelectorAll('.theme-btn').forEach((button) => {
			button.setAttribute('aria-label', label);
		});
	}

	function setTheme(light: boolean) {
		applyDocumentTheme(light);
		syncToggleLabels(light);
		document.dispatchEvent(
			new CustomEvent('themechange', { detail: { light } }),
		);
	}

	document.querySelectorAll('.theme-btn').forEach((button) => {
		syncToggleLabels(
			document.documentElement.classList.contains('theme-light'),
		);
		button.addEventListener('click', () => {
			const next = !document.documentElement.classList.contains('theme-light');
			localStorage.setItem(THEME_STORAGE_KEY, next ? 'light' : 'dark');
			setTheme(next);
		});
	});
</script>

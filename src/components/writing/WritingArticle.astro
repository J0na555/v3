---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { title, date, meta, dek } = post.data;
const { Content } = await render(post);
---

<article class="writing-article prose">
	<header>
		<h1>{title}</h1>
		{meta && <p class="eyebrow">{meta}</p>}
		<time datetime={date.toISOString()}>
			{date.toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})}
		</time>
		{dek && <p class="dek">{dek}</p>}
	</header>
	<Content />
</article>

<style>
	.eyebrow,
	header time,
	.dek {
		color: var(--muted);
	}
</style>

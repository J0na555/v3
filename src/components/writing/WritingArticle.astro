---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import '../../styles/article.css';

interface Props {
	post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { title, meta, dek } = post.data;
const { Content } = await render(post);
---

<article class="writing-article">
	<a href="/writing/" class="back-note">← All writing</a>
	{meta && <p class="meta-row">{meta}</p>}
	<h1>{title}</h1>
	{dek && <p class="dek">{dek}</p>}
	<div class="prose">
		<Content />
	</div>
</article>

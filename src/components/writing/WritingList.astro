---
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'writing'>[];
}

const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty-notes">No notes published yet.</p>
	) : (
		<ul class="writing-list">
			{
				posts.map((post) => {
					const displayTitle = post.data.title.replace(/^Notes — /, '');
					return (
						<li>
							<a href={`/writing/${post.id}/`} class="note-link">
								<h2>{displayTitle}</h2>
								{post.data.dek && <p>{post.data.dek}</p>}
								{post.data.meta && <span class="meta">{post.data.meta}</span>}
							</a>
						</li>
					);
				})
			}
		</ul>
	)
}
